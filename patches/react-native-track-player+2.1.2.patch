+package com.guichaguri.trackplayer.service;
+
+import android.support.v4.media.session.MediaSessionCompat;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * 持有 RNTP 播放服务的 MediaSession token，
+ * 供 app 侧的 VivoMediaBrowserService 共享同一会话（原子随身听点歌/控制）。
+ */
+public class MediaSessionHolder {
+    private static MediaSessionCompat.Token token;
+    private static final CopyOnWriteArrayList<Listener> listeners = new CopyOnWriteArrayList<>();
+
+    public interface Listener {
+        void onToken(MediaSessionCompat.Token token);
+    }
+
+    public static synchronized void setToken(MediaSessionCompat.Token t) {
+        token = t;
+        for (Listener listener : listeners) listener.onToken(t);
+    }
+
+    public static synchronized MediaSessionCompat.Token getToken() {
+        return token;
+    }
+
+    public static void addListener(Listener listener) {
+        if (listener == null) return;
+        listeners.addIfAbsent(listener);
+        MediaSessionCompat.Token t;
+        synchronized (MediaSessionHolder.class) {
+            t = token;
+        }
+        if (t != null) listener.onToken(t);
+    }
+
+    public static void removeListener(Listener listener) {
+        listeners.remove(listener);
+    }
+}
